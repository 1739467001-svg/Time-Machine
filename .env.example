# 默认本地占位引擎：无需 API Key，适合演示完整流程
AGING_PROVIDER=mock

# Gemini / nano-banana
# AGING_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 阿里云百炼 Qwen-Image-Edit
# AGING_PROVIDER=qwen
# 使用百炼按量付费业务空间 API Key；sk-sp- Token/Coding Plan 密钥不可混用
# DASHSCOPE_API_KEY=sk-ws-your_dashscope_api_key
# DASHSCOPE_REGION=cn
# 新版 sk-ws 密钥必须填写创建成功弹窗中的 API Host（不要包含接口路径）
# DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com
# QWEN_IMAGE_MODEL=qwen-image-edit

# StepFun Step Plan 图像编辑
# AGING_PROVIDER=stepfun
# STEPFUN_API_KEY=your_stepfun_api_key
# STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
# STEPFUN_IMAGE_MODEL=step-image-edit-2
