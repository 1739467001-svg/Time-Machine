# 复制为 .env.local 后填写。.env* 已被 git 忽略，不会提交。

# 变老引擎选择：mock（默认，本地占位，无需联网）| gemini（nano-banana 真实出图）
AGING_PROVIDER=mock

# 选 gemini 时必填：Google AI Studio 申请的 API Key
# https://aistudio.google.com
# 注意：Gemini 图像生成需要在项目上「开通 billing」，免费档图像配额为 0。
GEMINI_API_KEY=

# 可选：覆盖默认的 Gemini 图像模型名（默认 gemini-2.5-flash-image）。
# 已验证可用的更新模型（效果更好，按当下需要选）：
#   gemini-2.5-flash-image   （默认，便宜，约 $0.039/张）
#   gemini-3.1-flash-image   （更新的 flash 图像模型）
#   gemini-3-pro-image       （质量最高，即 “Nano Banana 2”）
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
